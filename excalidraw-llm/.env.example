# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to true to enable syncing chat data, LLM outputs, and diagram snapshots to Supabase. Defaults to false (local IndexedDB only).
VITE_ENABLE_SUPABASE_PERSISTENCE=false

